# NapCat WebUI 登录 token（首次启动写入 napcat/config/webui.json）
WEBUI_TOKEN=your_webui_token

# AstrBot WebUI 初始密码（≥8 位，需含大写、小写、数字）
ASTRBOT_PASSWORD=YourPassword123

# 宿主机端口映射
ASTRBOT_DASHBOARD_PORT=6185
ASTRBOT_ONEBOT_PORT=6199
NAPCAT_WEBUI_PORT=6099

# NapCat 容器运行用户，默认 1000
NAPCAT_UID=1000
NAPCAT_GID=1000

# ---- SnowLuma ----
# 远程桌面(noVNC)密码；留空则首次启动随机生成，只在日志打印一次
VNC_PASSWD=
# 端口监听地址：0.0.0.0 允许局域网访问，127.0.0.1 仅本机
BIND_ADDR=0.0.0.0
# 宿主机端口映射（容器内端口保持不变）
NOVNC_PORT=6081
SNOWLUMA_WEBUI_HOST_PORT=5099
ONEBOT_HTTP_PORT=3000
ONEBOT_WS_PORT=3001
# 容器内运行用户，需与数据卷属主一致
SNOWLUMA_UID=1000
SNOWLUMA_GID=1000
# 远程桌面分辨率 / 日志级别 / 自动注入 hook
SNOWLUMA_SCREEN=1920x1080x24
SNOWLUMA_LOG_LEVEL=info
SNOWLUMA_HOOK_AUTOLOAD=1
# 多开账号的额外 HOME 列表，逗号或空格分隔，如 /app/qq-acct2
SNOWLUMA_EXTRA_QQ_HOMES=
